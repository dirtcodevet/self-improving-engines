{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-report/0.1/lesson",
  "title": "One reported lesson",
  "description": "A lesson as the lesson-reporter packages it (SPEC.md, 'Lesson schema'). The prototype validates the same rules in code (lesson_reporter.validate_lessons); a test keeps the field lists in step. `target` must also be one of the engine's reporter.json lesson_targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "target", "title", "statement", "evidence", "toggle", "ratchet"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._#-]{0,63}$", "description": "Sender-local id, e.g. METHOD-92 or TM-frame_fit." },
    "kind": { "enum": ["check", "judgment", "tool", "method_note"] },
    "target": { "type": "string", "description": "Which skill the lesson is for: the engine, recursive-improvement or engine-grounding." },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "statement": { "type": "string", "minLength": 1, "maxLength": 1500, "description": "The lesson in the agent's own words; never quoted conversation, case facts or data." },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["log_ref", "summary"],
        "properties": {
          "log_ref": { "type": "string", "pattern": "^[A-Za-z0-9_.#/ -]{1,80}$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "measured": {
            "type": "object", "additionalProperties": false, "required": ["metric"],
            "properties": {
              "metric": { "type": "string", "minLength": 1, "maxLength": 60 },
              "before": { "type": ["number", "null"] },
              "after": { "type": ["number", "null"] },
              "unit": { "type": "string", "maxLength": 20 }
            }
          }
        }
      }
    },
    "toggle": {
      "type": "object", "additionalProperties": false, "required": ["flag", "default"],
      "description": "Every process change is switchable. A reported lesson always arrives OFF; the maintainer decides its default when merging.",
      "properties": {
        "flag": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]{1,63}$" },
        "default": { "const": false }
      }
    },
    "ratchet": {
      "type": "object", "additionalProperties": false, "required": ["loosens"],
      "description": "Checks only tighten without approval: a lesson that removes a check, loosens a threshold, changes a weight or what a check reads says so here.",
      "properties": {
        "loosens": { "type": "boolean" },
        "what": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "if": { "properties": { "loosens": { "const": true } } },
      "then": { "required": ["what"] }
    },
    "proof": {
      "type": "object", "additionalProperties": false, "required": ["planted_defect", "command", "expect"],
      "description": "Required for kind check and tool: the planted defect the check must catch, and one command (python|bash <engine tool> args) that shows it.",
      "properties": {
        "planted_defect": { "type": "string", "minLength": 1, "maxLength": 300 },
        "command": { "type": "string", "maxLength": 200, "pattern": "^(?:python3?|bash|sh)\\s+[A-Za-z0-9_./-]+(?:\\s+[A-Za-z0-9_./<>=:-]+)*$" },
        "expect": { "const": "fails_on_planted" }
      }
    },
    "replaces": { "type": "array", "maxItems": 10, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._#-]{0,63}$" } },
    "tool_change": { "type": "string", "pattern": "^[A-Za-z0-9_./-]{1,200}$", "description": "Engine-relative path of a tool diff in the same package." },
    "toolmaking": {
      "type": "object", "additionalProperties": false,
      "description": "OPTIONAL, never required (the tool-making record is kept, never gated): the TOOLMAKING.md columns for a new or changed tool.",
      "properties": {
        "trigger": { "type": "string", "maxLength": 300 },
        "caught": { "type": "string", "maxLength": 300 },
        "verdict": { "enum": ["good", "superseded", "flawed"] },
        "why": { "type": "string", "maxLength": 300 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "enum": ["check", "tool"] } } }, "then": { "required": ["proof"] } }
  ]
}
